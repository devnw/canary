*.csv

external/
!pkg/external/
dist/
out/

.direnv/
result
bin_canary

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

*.crt
*.key
*.pem

# ignore mac files
.DS_Store

.canary/
.codex/
.windsurf/
.crush/
.amazonq/                
.claude/                 
.kilocode/               
.augment/                
.codebuddy/              
.cursor/                 
.opencode/               
.roo/

# Superpowers SDD scratch
.superpowers/

# Stale build artifacts at repo root
/canary

# Local build output (test binaries, canary_debug, etc.)
/bin/

# Acceptance-test-generated fixtures: tools/canary/internal's tests run with
# cwd=tools/canary/internal, so their "tools/canary/testdata/..." relative
# paths land nested here; these are regenerated by every test run and were
# previously committed by accident.
/tools/canary/internal/tools/canary/testdata/

# Track the project canary config (JIRA source of truth) despite .canary/ being ignored
!.canary/
.canary/*
!.canary/project.yaml

# Backups written by `canary init --force` and `canary upgrade --write`:
# one generation deep (<file>.bak), overwritten by the next rewrite of the
# same file, and skipped by `canary scan`.
*.bak
